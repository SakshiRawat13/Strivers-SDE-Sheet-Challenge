 int orangesRotting(vector<vector<int>>& grid) {
        int n = grid.size(), m = grid[0].size();
        vector <vector<bool>> vis(n, vector <bool> (m, 0));
        int cntOfFreshOrange = 0;
        queue <pair<pair<int, int>, int>> q;
        // {{i, j}, time}
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(grid[i][j] == 1) {
                    cntOfFreshOrange++;
                }
                else if(grid[i][j] == 2) {
                    vis[i][j] = 1;
                    q.push({{i, j}, 0});
                }
            }
        }
        // cnt of rotten oranges converted
        int cntOfFreshToRotten = 0;
        int tMax = 0;
        int dx[] = {-1, 0, 1, 0};
        int dy[] = {0, 1, 0, -1};
        while(!q.empty()) {
            int row = q.front().first.first;
            int col = q.front().first.second;
            int currTime = q.front().second;

            q.pop();

            tMax = max(tMax, currTime);

            for(int i = 0; i < 4; i++) {
                int nrow = row + dx[i];
                int ncol = col + dy[i];
                if(nrow >= 0 && nrow < n && ncol >= 0 && ncol < m &&
                grid[nrow][ncol] == 1 && !vis[nrow][ncol]) {
                    vis[nrow][ncol] = 1;
                    cntOfFreshToRotten++;
                    q.push({{nrow, ncol}, currTime + 1});
                }
            }
        }

        return (cntOfFreshToRotten == cntOfFreshOrange) ? tMax : -1;
    }
// tc: o(n*m) sc: o(n*m)
